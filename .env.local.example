# Copy to .env.local and fill in with your Firebase project's web config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Shows the "Create one" sign-up form on /login. Leave unset/false once you've
# created your own account and applied database.rules.json + the staff/
# allowlist — a stray sign-up is harmless under those rules, but there's no
# reason to keep offering it. Set to "true" only while onboarding new staff.
NEXT_PUBLIC_ALLOW_SIGNUP=false